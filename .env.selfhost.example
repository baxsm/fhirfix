# copy to .env.selfhost and fill in. every value marked required has no default
# and compose will refuse to start without it.

# --- required secrets -------------------------------------------------------
# generate each with: openssl rand -base64 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
API_KEY_PEPPER=
WEBHOOK_ENCRYPTION_KEY=

# --- addresses --------------------------------------------------------------
# where users reach the dashboard and the api. change both when serving on a
# real hostname; PUBLIC_API_URL is compiled into the browser bundle at build
# time, so changing it later needs a rebuild, not just a restart.
APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
BETTER_AUTH_URL=http://localhost:3001
TRUSTED_ORIGINS=http://localhost:3000

FRONTEND_PORT=3000
BACKEND_PORT=3001

# --- terminology ------------------------------------------------------------
# left empty, the validator resolves codes against the public tx.fhir.org. that
# sends codes, never patient data, off the network - but if nothing at all may
# leave, choose one of:
#   TX_SERVER_URL=http://your-terminology-server/r4   point at your own
#   DISABLE_TX=true                                   skip terminology checks
# disabling means invalid codes stop being reported. it trades a class of
# finding for total network isolation.
TX_SERVER_URL=
DISABLE_TX=

# --- optional ---------------------------------------------------------------
POSTGRES_USER=fhirfix
POSTGRES_DB=fhirfix
US_CORE_VERSION=6.1.0
LOG_LEVEL=info
# raise on a host with more memory to give the validator more heap.
VALIDATOR_JAVA_OPTS=-XX:MaxRAMPercentage=75.0
