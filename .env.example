# Copy to .env and fill in. Services read their own subset (see each service's env schema).

# --- Core infra (backend + worker) ---
# host ports are shifted to avoid clashes with other local docker projects
DATABASE_URL="postgresql://fhirfix:fhirfix@localhost:5434/fhirfix"
REDIS_URL="redis://localhost:6380"

# --- Auth (backend) ---
# 32+ char random secret. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-in-production-use-a-long-random-string"
# Public URL the backend is reachable at (used by Better Auth for links/cookies)
BETTER_AUTH_URL="http://localhost:3001"
# Comma-separated origins allowed to call the backend (the frontend)
TRUSTED_ORIGINS="http://localhost:3000"

# --- Service wiring ---
# Backend HTTP port
BACKEND_PORT="3001"
# Frontend reads this to reach the backend (must be NEXT_PUBLIC_ to be client-visible)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# --- Email (backend) ZeptoMail ---
ZEPTOMAIL_TOKEN=""
ZEPTOMAIL_FROM_ADDRESS="no-reply@fhirfix.dev"
ZEPTOMAIL_FROM_NAME="FHIRfix"
# When true, emails are logged instead of sent (local dev + tests)
EMAIL_TEST_MODE="true"

# --- Observability (backend + frontend) ---
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Logging ---
LOG_LEVEL="info"

# --- Sidecars + local blob store (backend + worker), Phase 2 ---
# Comma-separated validator URLs form the ready-gated pool (one warm instance per URL).
VALIDATOR_URLS="http://localhost:4567"
VALIDATOR_MAX_INFLIGHT="4"
CONVERTER_URL="http://localhost:8081"
# Default IG pool version. A new pool is added when a newer version is offered.
US_CORE_VERSION="6.1.0"
# Absolute path shared by backend (input blobs) and worker (corrected blobs).
BLOB_STORE_DIR="/absolute/path/to/.data/blobs"
# Worker job concurrency.
WORKER_CONCURRENCY="4"

# ============================================================
# Later phases (leave blank for Phase 1)
# ============================================================

# Phase 4 billing (Polar). empty token => checkout is unavailable and the app
# runs on trial + granted credits only. use "sandbox" for test mode.
POLAR_ACCESS_TOKEN=""
POLAR_WEBHOOK_SECRET=""
POLAR_MODE="sandbox"
# one Polar product per credit pack.
POLAR_PRODUCT_PACK_10=""
POLAR_PRODUCT_PACK_25=""
POLAR_PRODUCT_PACK_100=""
# absolute frontend url used to build Polar success/return links.
APP_URL="http://localhost:3000"

# Phase 2/3 AI prose (OpenRouter)
OPENROUTER_API_KEY=""

# Phase 2 terminology (VSAC / UMLS)
UMLS_API_KEY=""

# Phase 8 secret encryption (libsodium sealed box key, base64)
SECRET_ENCRYPTION_KEY=""
