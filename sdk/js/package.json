{
  "name": "fhirfix",
  "version": "0.1.0",
  "description": "FHIRfix REST API client. Validate, fix, and convert FHIR conformance issues.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=18"
  },
  "keywords": ["fhir", "hl7", "validation", "healthcare", "interoperability"],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "bun test src/_tests/integration.test.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "npm run build && npm run check:publish",
    "check:publish": "publint && attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.2",
    "@biomejs/biome": "2.5.3",
    "@types/bun": "latest",
    "publint": "0.3.15",
    "tsup": "8.5.0",
    "typescript": "5.9.3"
  }
}
