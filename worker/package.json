{
  "name": "@fhirfix/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "sync:shared": "node ../scripts/sync-shared.mjs",
    "predev": "node ../scripts/sync-shared.mjs",
    "dev": "bun run --hot src/index.ts",
    "prestart": "node ../scripts/sync-shared.mjs",
    "start": "bun run src/index.ts",
    "pretypecheck": "node ../scripts/sync-shared.mjs",
    "typecheck": "bun x tsc --noEmit"
  },
  "dependencies": {
    "@t3-oss/env-core": "0.13.11",
    "bullmq": "5.80.2",
    "drizzle-orm": "0.45.2",
    "ioredis": "5.11.1",
    "nanoid": "6.0.0",
    "postgres": "3.4.9",
    "zeptomail": "8.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
