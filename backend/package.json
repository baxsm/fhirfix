{
  "name": "@fhirfix/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:shared": "node ../scripts/sync-shared.mjs",
    "predev": "node ../scripts/sync-shared.mjs",
    "dev": "bun run --hot src/index.ts",
    "prestart": "node ../scripts/sync-shared.mjs",
    "start": "bun run src/index.ts",
    "prebuild": "node ../scripts/sync-shared.mjs",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "pretypecheck": "node ../scripts/sync-shared.mjs",
    "typecheck": "bun x tsc --noEmit",
    "build:types": "bun x tsc -p tsconfig.emit.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "auth:generate": "bun x @better-auth/cli@latest generate --config src/auth/auth.ts --output ../db/schema/auth.ts --y",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts"
  },
  "dependencies": {
    "@hono/trpc-server": "0.4.2",
    "@polar-sh/sdk": "^0.48.1",
    "@sentry/node": "10.65.0",
    "@t3-oss/env-core": "0.13.11",
    "@trpc/server": "11.18.0",
    "better-auth": "1.6.23",
    "bullmq": "5.80.2",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.30",
    "ioredis": "5.11.1",
    "nanoid": "6.0.0",
    "postgres": "3.4.9",
    "zeptomail": "8.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bun": "latest",
    "drizzle-kit": "0.31.10",
    "standardwebhooks": "^1.0.0",
    "vitest": "4.1.10"
  }
}
