# host node_modules must never enter the build context. bun installs workspace
# deps to the root node_modules, so a copied-in backend/node_modules from the
# host shadows it with a partial tree and the service fails at import time.
**/node_modules

# build output, rebuilt inside the image
**/.next
**/dist
**/dist-types
**/out
**/build

# secrets and local state
.env
.env.*
!.env.example
backups
*.dump

# local-only
.claude
docs
.git
**/test-results
**/playwright-report
**/e2e/screenshots
*.mp4
